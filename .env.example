# 이 파일을 .env 로 복사해서 쓴다. .env 는 깃에 올리지 않는다.
#
#   cp .env.example .env
#
# VITE_ 접두사를 붙이지 않는다. 접두사가 붙은 값은 클라이언트 번들에 문자열로
# 박혀 브라우저에 그대로 노출된다. 아래 값들은 loader(서버)에서만 쓴다.

# 백엔드 API 서버 주소
API_BASE_URL=http://localhost:8080

# 로그인 세션 쿠키 서명용 비밀키. 아무 긴 무작위 문자열이면 된다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 배포 환경에는 로컬과 다른 값을 쓴다. 이 값이 새면 세션 쿠키를 위조할 수 있다.
SESSION_SECRET=change-me

# Swagger(OpenAPI) 문서의 JSON 주소 — `npm run gen:api` 가 읽는다.
# Swagger UI 페이지(/swagger-ui/index.html)가 아니라 JSON 경로다.
API_DOCS_URL=http://localhost:8080/v3/api-docs
